APP_NAME="Sistem Integrasi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=your-neon-user
DB_PASSWORD=your-neon-password
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="inventory@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

USER_NAME="Inventory User"
USER_USERNAME=user
USER_EMAIL=user@example.com
USER_PASSWORD=change-me

# Cloudinary untuk gambar produk
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# DOKU Sandbox
DOKU_CLIENT_ID=xxxxxxxx
DOKU_SECRET_KEY=xxxxxxxx
DOKU_MERCHANT_ID=xxxxxxxx
DOKU_PUBLIC_KEY=xxxxxxxx
# DOKU Checkout API sandbox endpoint (bukan URL halaman sandbox)
DOKU_API_URL=https://api-sandbox.doku.com
# Pakai HTTPS publik (mis. Cloudflare Tunnel/ngrok) agar DOKU dapat mengirim status pembayaran.
DOKU_NOTIFICATION_URL=https://your-public-domain.example/webhook/doku
